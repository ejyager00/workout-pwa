{% extends "base.njk" %}

{% block content %}
<div class="max-w-lg mx-auto">

  {% if not routine and not overridden and routines | length == 0 %}
    <div class="mb-5 p-3 bg-amber-50 border border-amber-200 rounded-lg text-sm text-amber-800">
      No routines yet.
      <a href="/routines" class="font-medium underline">Build one →</a>
    </div>
  {% elif not routine and not overridden %}
    <div class="mb-5 p-3 bg-amber-50 border border-amber-200 rounded-lg text-sm text-amber-800">
      Nothing scheduled for {{ dayName }}.
      <a href="/routines" class="font-medium underline">Schedule it →</a>
      or swap one in below.
    </div>
  {% endif %}

  {% if completed %}
    <div class="mb-5 p-3 bg-green-50 border border-green-200 rounded-lg text-sm text-green-800 font-medium">
      ✓ Workout complete for today!
    </div>
  {% endif %}

  {% include "partials/home/lifts-panel.njk" %}

</div>
{% endblock %}
