{# ── Lift heading: name/reps, or a tap-to-open editor while the day is live ──
   Edits land in daily_overrides only — the underlying routine is untouched. #}
{% macro liftHeading(item, csrfToken, completed, superset=false) %}
  {% if completed %}
    <div class="flex-1 min-w-0">
      <p class="font-medium text-gray-900 text-sm truncate">{{ item.lift_name }}</p>
      <p class="text-xs text-gray-500">{{ item.reps_min }}–{{ item.reps_max }} reps &times; {{ item.sets }} sets</p>
    </div>
  {% else %}
    {% set inputBorder = "border-red-200 bg-white" if superset else "border-gray-300" %}
    <details class="flex-1 min-w-0">
      <summary class="no-marker cursor-pointer">
        <span class="block font-medium text-gray-900 text-sm truncate">{{ item.lift_name }}</span>
        <span class="block text-xs text-gray-500">
          {{ item.reps_min }}–{{ item.reps_max }} reps &times; {{ item.sets }} sets
          <span class="text-gray-400">&middot; edit</span>
        </span>
      </summary>
      <form method="POST" action="/override/items/{{ item.id }}"
            hx-post="/override/items/{{ item.id }}"
            hx-target="#lifts-panel" hx-swap="outerHTML"
            class="mt-2 flex flex-wrap gap-2 items-center">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="text" name="lift_name" value="{{ item.lift_name }}"
               placeholder="Lift name" required maxlength="100"
               class="flex-1 min-w-32 border {{ inputBorder }} rounded px-2 py-1 text-sm focus:outline-none focus:ring-1 focus:ring-red-500">
        <div class="flex items-center gap-1 flex-shrink-0">
          <input type="number" name="reps_min" value="{{ item.reps_min }}" min="1" max="999" required
                 class="w-14 border {{ inputBorder }} rounded px-2 py-1 text-sm text-center focus:outline-none focus:ring-1 focus:ring-red-500">
          <span class="text-gray-400 text-xs">–</span>
          <input type="number" name="reps_max" value="{{ item.reps_max }}" min="1" max="999" required
                 class="w-14 border {{ inputBorder }} rounded px-2 py-1 text-sm text-center focus:outline-none focus:ring-1 focus:ring-red-500">
          <span class="text-gray-500 text-xs ml-1">reps</span>
        </div>
        <div class="flex items-center gap-1 flex-shrink-0">
          <input type="number" name="sets" value="{{ item.sets }}" min="1" max="99" required
                 class="w-12 border {{ inputBorder }} rounded px-2 py-1 text-sm text-center focus:outline-none focus:ring-1 focus:ring-red-500">
          <span class="text-gray-500 text-xs">sets</span>
        </div>
        <button type="submit"
                class="text-xs bg-red-50 hover:bg-red-100 text-red-800 font-medium py-1 px-2 rounded transition-colors flex-shrink-0">
          Save
        </button>
      </form>
    </details>
  {% endif %}
{% endmacro %}

<div id="lifts-panel">

  {# ── Today's routine: what it is, and how to run a different one ── #}
  <div class="mb-5">

    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        {% if routine %}
          <p class="text-sm font-medium text-gray-900 truncate">{{ routine.name }}</p>
        {% elif groups | length > 0 %}
          <p class="text-sm font-medium text-gray-900">Custom workout</p>
        {% else %}
          <p class="text-sm text-gray-400">Rest day</p>
        {% endif %}
      </div>

      {% if not completed and routines | length > 0 %}
        <form method="POST" action="/override/routine"
              hx-post="/override/routine"
              hx-target="#lifts-panel" hx-swap="outerHTML"
              hx-trigger="change from:find select"
              {# Only worth confirming when there are edits to lose #}
              {% if overridden %}hx-confirm="Replace today's lifts with this routine?"{% endif %}
              class="flex-shrink-0">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <select name="routine_id"
                  class="border border-gray-300 rounded px-2 py-1 text-xs bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-red-500">
            <option value="" selected>Swap routine…</option>
            {% for r in routines %}
              <option value="{{ r.id }}">{{ r.name }}</option>
            {% endfor %}
          </select>
        </form>
      {% endif %}
    </div>

    {# Only shown once today has diverged from the weekly schedule #}
    {% if overridden and not completed %}
      <div class="mt-1.5 flex items-center gap-2 text-xs text-gray-500">
        <span class="min-w-0 truncate">
          {% if routine and scheduledRoutine and routine.id == scheduledRoutine.id %}
            Customized for today
          {% elif scheduledRoutine %}
            Instead of {{ scheduledRoutine.name }}
          {% else %}
            {{ dayName }} is normally a rest day
          {% endif %}
        </span>
        <form method="POST" action="/override/reset"
              hx-post="/override/reset"
              hx-target="#lifts-panel" hx-swap="outerHTML"
              hx-confirm="Discard today's changes and go back to the scheduled routine?"
              class="flex-shrink-0">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <button type="submit" class="underline hover:text-gray-700">Reset</button>
        </form>
      </div>
    {% endif %}

  </div>

  {# ── Hidden forms that inputs across the panel associate with ── #}

  {# Complete-workout form (always present; set inputs link via form="complete-form") #}
  <form id="complete-form" method="POST" action="/complete">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <input type="hidden" name="date"  value="{{ today }}">
    {# Lift structure fields – must be in flatIdx order #}
    {% for group in groups %}
      {% for item in group.items %}
        <input type="hidden" name="lift_name[]"    value="{{ item.lift_name }}"           form="complete-form">
        <input type="hidden" name="lift_superset[]" value="{{ item.superset_id if item.superset_id else '' }}" form="complete-form">
      {% endfor %}
    {% endfor %}
  </form>

  {# Superset-grouping form (checkboxes across the panel link here) #}
  <form id="superset-form" method="POST" action="/override/superset"
        hx-post="/override/superset" hx-target="#lifts-panel" hx-swap="outerHTML">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
  </form>

  {# ── Lift cards ── #}
  <div class="space-y-3 mb-4">

    {% if groups | length == 0 %}
      <p class="text-center text-sm text-gray-400 py-6">
        No lifts yet today.{% if not completed %} Swap in a routine above, or add one below.{% endif %}
      </p>
    {% endif %}

    {% for group in groups %}

      {% if group.type == "standalone" %}
        {% set item = group.items[0] %}
        <div class="border border-gray-200 rounded-lg bg-white overflow-hidden">

          {# Card header #}
          <div class="flex items-start gap-2 px-3 pt-3 pb-2">
            {% if not completed %}
              <input type="checkbox" name="item_ids[]" value="{{ item.id }}"
                     form="superset-form"
                     class="mt-1 h-4 w-4 rounded border-gray-300 text-red-700 flex-shrink-0">
            {% endif %}
            {{ liftHeading(item, csrfToken, completed) }}
            {% if not completed %}
              <div class="flex gap-1 flex-shrink-0">
                <form method="POST" action="/override/items/{{ item.id }}/move"
                      hx-post="/override/items/{{ item.id }}/move"
                      hx-target="#lifts-panel" hx-swap="outerHTML">
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                  <input type="hidden" name="direction" value="up">
                  <button type="submit" class="text-gray-400 hover:text-gray-600 p-0.5">&#8593;</button>
                </form>
                <form method="POST" action="/override/items/{{ item.id }}/move"
                      hx-post="/override/items/{{ item.id }}/move"
                      hx-target="#lifts-panel" hx-swap="outerHTML">
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                  <input type="hidden" name="direction" value="down">
                  <button type="submit" class="text-gray-400 hover:text-gray-600 p-0.5">&#8595;</button>
                </form>
                <form method="POST" action="/override/items/{{ item.id }}/delete"
                      hx-post="/override/items/{{ item.id }}/delete"
                      hx-target="#lifts-panel" hx-swap="outerHTML">
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                  <button type="submit" hx-confirm="Remove {{ item.lift_name }} from today?"
                          class="text-red-400 hover:text-red-600 p-0.5">&times;</button>
                </form>
              </div>
            {% endif %}
          </div>

          {# Stats #}
          {% if item.stat and (item.stat.recentDate or item.stat.bestDate) %}
            <div class="px-3 pb-2 space-y-0.5">
              {% if item.stat.recentDate %}
                <p class="text-xs text-gray-400">
                  <span class="font-medium text-gray-500">Last</span>
                  {{ item.stat.recentDate }} &middot;
                  {% for s in item.stat.recentSets %}{{ s.reps }}&times;{{ s.weight }}{% if not loop.last %}, {% endif %}{% endfor %}
                </p>
              {% endif %}
              {% if item.stat.bestDate %}
                <p class="text-xs text-gray-400">
                  <span class="font-medium text-gray-500">Best</span>
                  {{ item.stat.bestDate }} &middot;
                  {% for s in item.stat.bestSets %}{{ s.reps }}&times;{{ s.weight }}{% if not loop.last %}, {% endif %}{% endfor %}
                </p>
              {% endif %}
            </div>
          {% endif %}

          {# Inline logging set inputs #}
          {% if inlineLogging and not completed %}
            <div class="border-t border-gray-100 px-3 py-2 space-y-1.5">
              {% for s in range(item.sets) %}
                <div class="flex items-center gap-2">
                  <span class="text-xs text-gray-400 w-10 flex-shrink-0">Set {{ s + 1 }}</span>
                  <input type="hidden" name="set_lift[]" value="{{ item.flatIdx }}" form="complete-form">
                  <input type="number" name="set_reps[]" placeholder="Reps" min="0" max="9999"
                         form="complete-form"
                         class="w-full border border-gray-300 rounded px-2 py-1 text-sm text-center focus:outline-none focus:ring-1 focus:ring-red-500">
                  <span class="text-gray-400 text-xs flex-shrink-0">&times;</span>
                  <input type="number" name="set_weight[]" placeholder="lbs" min="0" max="9999" step="0.5"
                         form="complete-form"
                         class="w-full border border-gray-300 rounded px-2 py-1 text-sm text-center focus:outline-none focus:ring-1 focus:ring-red-500">
                  <span class="text-xs text-gray-400 flex-shrink-0">lbs</span>
                </div>
              {% endfor %}
            </div>
          {% endif %}

        </div>

      {% else %}
        {# ── Superset group ── #}
        <div class="border-2 border-red-200 rounded-lg overflow-hidden bg-red-50">

          <div class="flex items-center justify-between px-3 py-1.5 bg-red-100 border-b border-red-200">
            <span class="text-xs font-semibold text-red-800 uppercase tracking-wide">Superset</span>
            {% if not completed %}
              <div class="flex gap-1">
                <form method="POST" action="/override/items/{{ group.items[0].id }}/move"
                      hx-post="/override/items/{{ group.items[0].id }}/move"
                      hx-target="#lifts-panel" hx-swap="outerHTML" class="inline">
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                  <input type="hidden" name="direction" value="up">
                  <button type="submit" class="text-red-500 hover:text-red-800 text-sm px-1">&#8593;</button>
                </form>
                <form method="POST" action="/override/items/{{ group.items[0].id }}/move"
                      hx-post="/override/items/{{ group.items[0].id }}/move"
                      hx-target="#lifts-panel" hx-swap="outerHTML" class="inline">
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                  <input type="hidden" name="direction" value="down">
                  <button type="submit" class="text-red-500 hover:text-red-800 text-sm px-1">&#8595;</button>
                </form>
              </div>
            {% endif %}
          </div>

          <div class="divide-y divide-red-100">
            {% for item in group.items %}
              <div class="px-3 pt-2.5 pb-2">

                <div class="flex items-start gap-2">
                  {{ liftHeading(item, csrfToken, completed, true) }}
                  {% if not completed %}
                    <div class="flex items-center gap-2 flex-shrink-0">
                      <form method="POST" action="/override/items/{{ item.id }}/unsuperset"
                            hx-post="/override/items/{{ item.id }}/unsuperset"
                            hx-target="#lifts-panel" hx-swap="outerHTML">
                        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                        <button type="submit" class="text-xs text-red-500 hover:text-red-800">Ungroup</button>
                      </form>
                      <form method="POST" action="/override/items/{{ item.id }}/delete"
                            hx-post="/override/items/{{ item.id }}/delete"
                            hx-target="#lifts-panel" hx-swap="outerHTML">
                        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                        <button type="submit" hx-confirm="Remove {{ item.lift_name }} from today?"
                                class="text-red-400 hover:text-red-600">&times;</button>
                      </form>
                    </div>
                  {% endif %}
                </div>

                {# Stats #}
                {% if item.stat and (item.stat.recentDate or item.stat.bestDate) %}
                  <div class="mt-1 space-y-0.5">
                    {% if item.stat.recentDate %}
                      <p class="text-xs text-gray-400">
                        <span class="font-medium text-gray-500">Last</span>
                        {{ item.stat.recentDate }} &middot;
                        {% for s in item.stat.recentSets %}{{ s.reps }}&times;{{ s.weight }}{% if not loop.last %}, {% endif %}{% endfor %}
                      </p>
                    {% endif %}
                    {% if item.stat.bestDate %}
                      <p class="text-xs text-gray-400">
                        <span class="font-medium text-gray-500">Best</span>
                        {{ item.stat.bestDate }} &middot;
                        {% for s in item.stat.bestSets %}{{ s.reps }}&times;{{ s.weight }}{% if not loop.last %}, {% endif %}{% endfor %}
                      </p>
                    {% endif %}
                  </div>
                {% endif %}

                {# Inline logging set inputs #}
                {% if inlineLogging and not completed %}
                  <div class="mt-2 space-y-1.5">
                    {% for s in range(item.sets) %}
                      <div class="flex items-center gap-2">
                        <span class="text-xs text-gray-400 w-10 flex-shrink-0">Set {{ s + 1 }}</span>
                        <input type="hidden" name="set_lift[]" value="{{ item.flatIdx }}" form="complete-form">
                        <input type="number" name="set_reps[]" placeholder="Reps" min="0" max="9999"
                               form="complete-form"
                               class="w-full border border-red-200 rounded px-2 py-1 text-sm text-center bg-white focus:outline-none focus:ring-1 focus:ring-red-500">
                        <span class="text-gray-400 text-xs flex-shrink-0">&times;</span>
                        <input type="number" name="set_weight[]" placeholder="lbs" min="0" max="9999" step="0.5"
                               form="complete-form"
                               class="w-full border border-red-200 rounded px-2 py-1 text-sm text-center bg-white focus:outline-none focus:ring-1 focus:ring-red-500">
                        <span class="text-xs text-gray-400 flex-shrink-0">lbs</span>
                      </div>
                    {% endfor %}
                  </div>
                {% endif %}

              </div>
            {% endfor %}
          </div>

        </div>
      {% endif %}

    {% endfor %}

  </div>

  {# ── Make superset button (2+ standalone items) ── #}
  {% if not completed and groups | length >= 2 %}
    <div class="mb-4">
      <button type="submit" form="superset-form"
              class="text-sm text-red-700 hover:text-red-900 border border-red-200 hover:border-red-500 rounded px-3 py-1.5 transition-colors">
        Group selected as superset
      </button>
    </div>
  {% endif %}

  {# ── Add lift for today ── #}
  {% if not completed %}
    <div class="border border-dashed border-gray-300 rounded-lg p-3 mb-4">
      <p class="text-xs font-medium text-gray-500 mb-2 uppercase tracking-wide">Add lift for today</p>
      <form method="POST" action="/override/items"
            hx-post="/override/items" hx-target="#lifts-panel" hx-swap="outerHTML"
            hx-on::after-request="this.reset()">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <div class="flex flex-wrap gap-2 items-center">
          <input type="text" name="lift_name" placeholder="Lift name" required maxlength="100"
                 class="flex-1 min-w-32 border border-gray-300 rounded px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-red-500">
          <div class="flex items-center gap-1 flex-shrink-0">
            <input type="number" name="reps_min" value="8" min="1" max="999" required
                   class="w-14 border border-gray-300 rounded px-2 py-1.5 text-sm text-center focus:outline-none focus:ring-2 focus:ring-red-500">
            <span class="text-gray-400 text-xs">–</span>
            <input type="number" name="reps_max" value="12" min="1" max="999" required
                   class="w-14 border border-gray-300 rounded px-2 py-1.5 text-sm text-center focus:outline-none focus:ring-2 focus:ring-red-500">
            <span class="text-gray-500 text-xs ml-1">reps</span>
          </div>
          <div class="flex items-center gap-1 flex-shrink-0">
            <input type="number" name="sets" value="3" min="1" max="99" required
                   class="w-12 border border-gray-300 rounded px-2 py-1.5 text-sm text-center focus:outline-none focus:ring-2 focus:ring-red-500">
            <span class="text-gray-500 text-xs">sets</span>
          </div>
          <button type="submit"
                  class="bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium py-1.5 px-3 rounded transition-colors flex-shrink-0">
            + Add
          </button>
        </div>
      </form>
    </div>
  {% endif %}

  {# ── Complete Workout ── #}
  {% if not completed %}
    <button type="submit" form="complete-form"
            class="w-full bg-red-700 hover:bg-red-800 text-white font-semibold py-3 rounded-lg text-sm transition-colors">
      Complete Workout
    </button>
  {% endif %}

</div>
